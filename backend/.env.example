# Comma-separated list is not supported here; set via APP_CORS_ORIGINS as a JSON array, e.g.
# APP_CORS_ORIGINS=["http://localhost:5173"]
APP_CORS_ORIGINS=["http://localhost:5173"]

# Caching and rate limiting (defaults shown; see app/config.py). Uncomment to override.
# APP_CACHE_TTL_SECONDS=3600
# APP_CACHE_MAX_ENTRIES=128
# APP_MAX_CONCURRENT_COMPUTATIONS=2
# APP_HTTP_CACHE_MAX_AGE=3600
# APP_RATE_LIMIT_DEFAULT=120/minute
# APP_RATE_LIMIT_HEAVY=30/minute
# Proxies that append to X-Forwarded-For (Render: 1). Use 0 when nothing sits in front of the app.
# APP_TRUSTED_PROXY_HOPS=1
